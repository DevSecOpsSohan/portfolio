{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Without this the asset router answers before the Worker runs, so the
    // security headers set in src/index.js never reach a single HTML page.
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-enquiries",
      "database_id": "6832ff1f-b531-46e1-b41e-de374224cb6d"
    }
  ],
  "observability": {
    "enabled": true
  }
}
